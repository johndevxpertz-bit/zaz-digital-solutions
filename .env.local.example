# Contact form email delivery (app/contact/actions.ts)
#
# Without RESEND_API_KEY set, the contact form still validates and runs its
# spam checks, but honestly reports an error instead of pretending to send —
# no message is delivered anywhere until this is configured.
#
# 1. Create a free account at https://resend.com
# 2. Create an API key and paste it below
# 3. (Recommended for production) verify your sending domain in Resend, then
#    set CONTACT_FROM_EMAIL to an address on that domain. Until then, the
#    default "onboarding@resend.dev" sender works but is clearly a test sender.
RESEND_API_KEY=

# Every submission always notifies support@zazdigitalsolutions.com and
# maazqureshi632@gmail.com (hardcoded in app/contact/actions.ts) — that pair
# can't be removed by env config. CONTACT_TO_EMAIL is optional and only adds
# further recipients (comma-separated) on top of those two.
# CONTACT_TO_EMAIL=someone-else@example.com
# CONTACT_FROM_EMAIL=ZAZ Digital Solutions Website <onboarding@resend.dev>

# ZAZ AI chatbot (app/api/chat/route.ts)
#
# Uses the Google Gemini API (gemini-2.5-flash-lite) — free tier, no billing
# account required. Without GEMINI_API_KEY set, the chat widget still works
# end-to-end, but every message gets the same honest fallback reply ("I'm
# having trouble connecting right now...") instead of a real AI response —
# no request is ever sent to Gemini until this is configured. Never exposed
# to the browser: only read server-side inside the API route.
#
# 1. Create a free API key at https://aistudio.google.com/apikey (no card required)
# 2. Paste it below
GEMINI_API_KEY=
